# ====================================================
# 本機開發環境設定範本
# 使用方法: cp .env.example .env，再依需求調整
# ====================================================

# === Docker MySQL ===
# 本機 host port（如果 3306 被佔用，改用 3308 等其他 port）
MYSQL_HOST_PORT=3306
MYSQL_DATABASE=shop_db
MYSQL_ROOT_PASSWORD=root

# === Spring Boot DataSource ===
# 注意：URL 含 & 字元必須加引號
DATABASE_URL="jdbc:mysql://localhost:3306/shop_db?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true"
DATABASE_USERNAME=root
DATABASE_PASSWORD=root

# === JWT ===
JWT_SECRET=ThisIsAVerySecureSecretKeyForLocalDevelopment2026!!

# === Cloudinary（本機可填假值，圖片上傳功能會失敗但不影響其他開發）===
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# === Google OAuth（本機可填假值）===
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# === 前端 URL（CORS 用）===
FRONTEND_URL=http://localhost:5173
